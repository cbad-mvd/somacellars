{% extends "matrix/default" %}

{% set banner = block %}

{% block blockContent %}
<div class="leftcolumn">
    {% if banner.textMsg|striptags == globalVars.shipcode %}
        {% set message = "%s %s %s"|format( globalVars.shipcodepre, 
                                            globalVars.shipcode, 
                                            globalVars.shipcodepost) %}

    {% else %}
        {% set message = banner.textMsg  %}
    {% endif %}
    <p>
        {{ message }}
    </p>

</div>

{% endblock %}
